const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const cors = require('cors');

const app = express();
app.use(cors()); // Allow cross-origin requests from frontend

const server = http.createServer(app);

// Initialize Socket.io with secure CORS rules
const io = new Server(server, {
    cors: {
        origin: "http://localhost:5173", // Standard Vite+React local port
        methods: ["GET", "POST"]
    }
});

// Watch for client connections
io.on('connection', (socket) => {
    console.log(`⚡ User connected: ${socket.id}`);

    // Listen for custom event from a client
    socket.on('send_message', (data) => {
        console.log('📬 Message received:', data);
        
        // Broadcast the message instantly to ALL connected clients
        io.emit('receive_message', data);
    });

    // Handle user disconnects safely
    socket.on('disconnect', () => {
        console.log(`❌ User disconnected: ${socket.id}`);
    });
});

const PORT = 3001;
server.listen(PORT, () => {
    console.log(`🚀 Real-time WebSocket server running on port ${PORT}`);
});
